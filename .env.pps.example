# ============================================
# IRS PPS Call Automation - Environment Variables
# ============================================
# Copy this file to .env.local and fill in values

# --- Supabase (existing) ---
SUPABASE_URL=https://nixzwnfjglojemozlvmf.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# --- Twilio ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Comma-separated list of Twilio phone numbers for rotating callbacks
PPS_CALLBACK_NUMBERS=+14155551234,+14155555678

# --- Deepgram (real-time transcription) ---
DEEPGRAM_API_KEY=your_deepgram_api_key

# --- Anthropic (AI agent) ---
ANTHROPIC_API_KEY=your_anthropic_api_key

# --- PPS System ---
# API key for authenticating PPS dashboard/API requests
PPS_API_KEY=your_secure_api_key

# WebSocket server host (for production, this is wherever ws-server.js is deployed)
PPS_WS_HOST=localhost:8080
WS_PORT=8080

# Base URL for Twilio webhooks (auto-detected on Vercel, set for local dev)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# --- Encryption (existing) ---
ENCRYPTION_KEY=your_64_char_hex_encryption_key
